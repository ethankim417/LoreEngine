# No environment variables are required for normal mock-data browsing.
#
# Optional: protect Vercel Cron/admin refresh routes.
# CRON_SECRET=
#
# Firebase Auth/Firestore uses firebase-applet-config.json.
# Do not add Firebase service account private keys to this frontend build.
#
# Future AI/news production example:
# AI_API_KEY=
# DATABASE_URL=
