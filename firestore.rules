rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper Functions
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return request.auth.uid == userId; }
    function existing() { return resource.data; }
    function incoming() { return request.resource.data; }
    
    // User Validator
    function isValidUser(data) {
      return (data.get('bookmarkIds', []) is list) &&
             (data.get('bookmarkIds', []).size() <= 250) &&
             (data.get('language', '') is string) &&
             (data.get('language', '').size() <= 10) &&
             (data.get('updatedAt', '') is string);
    }
    
    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && isValidUser(incoming());
      allow update: if (
        isSignedIn() && 
        isOwner(userId) && 
        isValidUser(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['bookmarkIds', 'language', 'updatedAt'])
      );
      allow delete: if isSignedIn() && isOwner(userId);
    }
  }
}
